# Copy to .env and adjust. Read by apps/api/src/ruralminds/config.py (prefix RURALMINDS_).
RURALMINDS_ENV=development
RURALMINDS_DB_PATH=data/ruralminds.db

# API: 0.0.0.0 so phones on the hotspot can reach it; use 127.0.0.1 for solo dev
RURALMINDS_API_HOST=0.0.0.0
RURALMINDS_API_PORT=8000

# Local llama-server instances only (never internet hosts). Not Ollama.
# Chat server binary (a Vulkan build runs the model on the iGPU) and the embedder's binary
RURALMINDS_LLAMA_SERVER_PATH=llama-server
RURALMINDS_EMBED_SERVER_PATH=
RURALMINDS_LLM_URL=http://127.0.0.1:8080
RURALMINDS_EMBED_URL=http://127.0.0.1:8081
# Name shown on the admin screen (the file may be an Ollama blob hash)
RURALMINDS_CHAT_MODEL_LABEL=
RURALMINDS_CHAT_MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
RURALMINDS_EMBED_MODEL_PATH=models/bge-m3-Q8_0.gguf
# Server sizing, read by scripts/start_all.ps1 (LLM_PARALLEL also sizes the API's answer queue)
RURALMINDS_LLM_CTX=8192
RURALMINDS_LLM_PARALLEL=2
# Layers offloaded to the GPU: 0 = CPU only, 99 = all (needs a GPU build)
RURALMINDS_LLM_GPU_LAYERS=0
# KV cache type and flash attention: CPU q8_0 + auto; Radeon iGPU (Vulkan) f16 + off (measured faster)
RURALMINDS_LLM_KV_TYPE=q8_0
RURALMINDS_LLM_FLASH_ATTN=auto
RURALMINDS_EMBED_CTX=4096
RURALMINDS_THREADS=8

# Generation / retrieval
RURALMINDS_TEMPERATURE=0.2
RURALMINDS_MAX_TOKENS=300
RURALMINDS_FINAL_TOP_K=4
RURALMINDS_MAX_CONTEXT_TOKENS=600
# Min cosine similarity when no keyword hit (gate layer 1). Placeholder: calibrate on the dev split
RURALMINDS_REFUSAL_THRESHOLD=0.5
RURALMINDS_MAX_QUEUE=30

# Accounts: no self sign-up. Create the admin with `python -m ruralminds.admin init`;
# the admin then creates teacher and student accounts. Idle sign-out in minutes:
RURALMINDS_STUDENT_IDLE_MINUTES=30
RURALMINDS_TEACHER_IDLE_MINUTES=480
RURALMINDS_LOGIN_MAX_FAILURES=5

# Teacher uploads: checked while the file streams in; refused if free disk would drop below the floor
RURALMINDS_MAX_UPLOAD_MB=60
RURALMINDS_MAX_PAGES=400
RURALMINDS_MIN_FREE_DISK_GB=2
RURALMINDS_MAX_INGEST_ATTEMPTS=3
